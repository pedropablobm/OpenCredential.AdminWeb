<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DesktopSourceRoot Condition="'$(DesktopSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\OpenCredential\Plugins\Core\DatabaseAuth\DatabaseAuth</DesktopSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\OpenCredential.AdminWeb.csproj" />
    <Compile Include="$(DesktopSourceRoot)\UserEntry.cs" Link="Desktop\UserEntry.cs" />
    <Compile Include="$(DesktopSourceRoot)\BCryptHasher.cs" Link="Desktop\BCryptHasher.cs" />
  </ItemGroup>
</Project>
