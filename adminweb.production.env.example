# Copia a adminweb.production.env y protege el archivo con chmod 600.
# El hostname debe coincidir con el certificado del servidor PostgreSQL.
Database__ConnectionString=Host=postgres.example.org;Port=5432;Database=opencredential;Username=opencredential_adminweb;Password=REEMPLAZAR;SSL Mode=VerifyFull;Root Certificate=/certs/postgres-ca.crt
AdminAuth__Username=admin
AdminAuth__Password=REEMPLAZAR
AdminAuth__Role=SuperAdmin
# IP exacta desde la que el proxy HTTPS se conecta al contenedor; no uses la IP del navegador.
# ForwardedHeaders__TrustedProxies__0=192.0.2.1
