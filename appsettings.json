{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Mode": "Json",
    "Provider": "PostgreSql",
    "ConnectionString": "",
    "AutoInitialize": true
  },
  "AdminAuth": {
    "Enabled": true,
    "Username": "",
    "Password": "",
    "PasswordHash": "",
    "HashMethod": "BCRYPT",
    "Role": "SuperAdmin",
    "CookieName": "opencredential_admin",
    "PortalCookieName": "opencredential_portal",
    "SessionHours": 12,
    "PortalSessionHours": 12,
    "PortalRecoveryTokenLifetimeMinutes": 20,
    "PortalRevealRecoveryTokenInResponse": false,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "AdminLoginRateLimitPerMinute": 10,
    "PortalLoginRateLimitPerMinute": 10,
    "PortalRecoveryRateLimitPerHour": 5,
    "PortalResetRateLimitPerHour": 8,
    "Accounts": [],
    "PortalAllowedGroups": [ "Estudiantes", "Docentes", "Funcionarios", "AdminWeb-SuperAdmin", "AdminWeb-Coordinador", "AdminWeb-Operador" ]
  },
  "ForwardedHeaders": {
    "TrustedProxies": []
  },
  "AllowedHosts": "*"
}
